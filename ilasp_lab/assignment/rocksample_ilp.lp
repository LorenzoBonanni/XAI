#include <incmode>.


#program base.

dist(0..24).
rock(0..4).
cell((0..11,0..11)).

%good(0..1) :- ... %replaced by the axioms generated by ILASP
1 {good(V1) } 1 :- V2 >= 80; guess(V1, V2).

loc(0, (2,2)).
loc(1, (5,2)).
loc(2, (2,4)).
loc(3, (9,9)).

at((0,0), 1).

guess(0,70).
guess(1,40).
guess(2,90).
guess(3,10).

%dist(R, X) :- ...


#program step(t).
1 {east(t); north(t); south(t); west(t); sample(R, t): at((X,Y),t), loc(R, (X,Y)), rock(R)} 1.

% movements actions
at((X,Y+1), t+1)            :- north(t), at((X,Y), t).
at((X,Y-1), t+1)            :- south(t), at((X,Y), t).
at((X-1,Y), t+1)            :- west(t), at((X,Y), t).
at((X+1,Y), t+1)            :- east(t), at((X,Y), t).

at((X,Y), t+1)              :- sample(R, t), at((X,Y), t).
sampled(R,t+1)              :- sample(R, t).
sampled(R,t+1)              :- sampled(R,t).


% Constraints
:- east(t), at((10, Y), t).
:- west(t), at((0, Y), t).
:- south(t), at((X, 0), t).
:- north(t), at((X, 10), t).
:- sample(R, t), sampled(R,t).


#program check(t).
%:- query(t), t<2.
:- query(t), not sampled(R,t), good(R).



#show east/1.
#show south/1.
#show north/1.
#show west/1.
#show sample/2.
%#show good/1.
%#show dist/2.
